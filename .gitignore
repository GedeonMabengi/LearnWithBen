# --- Écosystème Node / React / Vite ---
/node_modules
/public/build
/public/hot
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Écosystème PHP / Laravel ---
/vendor
.env
.env.backup
.env.production
chatter.log
-homestead
Homestead.json
Homestead.yaml
.vagrant
.phpunit.result.cache

# --- Fichiers de stockage et Logs Laravel ---
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/public/*

# Exception pour conserver les dossiers de stockage vides sur Git
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/app/public/.gitignore

